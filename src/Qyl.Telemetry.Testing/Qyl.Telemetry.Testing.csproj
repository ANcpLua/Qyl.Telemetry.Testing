<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Trace-isolated OTLP evidence for native MSTest tests.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Qyl.Telemetry.SemanticConventions" Version="13.1.1"/>
        <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0"/>
        <PackageReference Include="Google.Protobuf" Version="3.36.2"/>
        <PackageReference Include="Grpc.AspNetCore.Server" Version="2.84.0"/>
        <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all"/>
        <PackageReference Include="MSTest.TestFramework" Version="4.5.1"/>
        <PackageReference Include="MSTest.Analyzers" Version="4.5.1" PrivateAssets="all"/>
        <Protobuf Include="Protos/**/*.proto" ProtoRoot="Protos" GrpcServices="None" Access="Internal"/>
        <None Include="../../README.md" Pack="true" PackagePath="/"/>
        <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/"/>
        <None Remove="Protos/LICENSE"/>
        <None Include="Protos/LICENSE" Pack="true" PackagePath="licenses/opentelemetry-proto/"/>
        <InternalsVisibleTo Include="Qyl.Telemetry.Testing.Tests"/>
    </ItemGroup>
</Project>
